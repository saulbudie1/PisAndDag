	PouchOfBerries: {
		DisplayName: Pouch of Berries
		Tooltip: They did not rot. They went soft instead.
	}

	GameChangingOrb: {
		DisplayName: Ominous Orb
		Tooltip:
			'''
			Can only be set upon an anvil
			Once placed, it cannot be taken back
			Break it, and the world is asked a question it cannot refuse
			'''
	}

	Accessories: {
		RageOfAThunder: {
			DisplayName: Rage Of A Thunder
			Tooltip: ""
		}
	}

	Chlorophyte_Rifle: {
		DisplayName: Chlorophyte Rifle
		Tooltip: ""
	}

	DentedMegashark: {
		DisplayName: Dented Megashark
		Tooltip: ""
	}

	Instrument: {
		Trumpet: {
			DisplayName: Trumpet
			Tooltip:
				'''
				Twelve bands down the screen, low at the bottom: where the cursor is, is the note
				Left click plays it, right click plays it an octave up
				Hold to sustain, drag to slide, fifteen seconds at most. Alt plays soft
				'It has never once been played quietly.'
				'''
		}
	}

	Trumpet: {
		DisplayName: Trumpet
		Tooltip: ""
	}

	GreatbowOfAPilgrim: {
		DisplayName: She Who Sings
		Tooltip: Wait 5 seconds to shoot a piercing arrow
	}

	MeagreFlame: {
		DisplayName: Meagre Flame
		Tooltip:
			'''
			Throws a ball of fire that bursts on what it meets
			Hold 2 seconds to gather it: twice the size, three times the damage, 40 mana
			'Enough to set a thing alight. Not much more.'
			'''
	}

	SealOfAClothier: {
		DisplayName: Clothier's Chatelaine
		Tooltip: "[c/9e6fab:A Seal]"
	}

	CourtOfHands: {
		DisplayName: Court of Hands
		Tooltip:
			'''
			Calls hands up out of the ground under the cursor, three at a time, for 5 seconds
			Click elsewhere to move them. Hold 2 seconds and they follow the cursor, at 14 mana a second
			'Can I get a show of hands?'
			'''
	}

	EverHunger: {
		DisplayName: Everhunger
		Tooltip:
			'''
			Lets a mouth out of your chest that runs level, toward the cursor's side
			Comes back for the first thing it bites, dies after 5 bites
			Anything else in its way takes two thirds the damage
			'It is never full. It only runs out.'
			'''
	}
}

