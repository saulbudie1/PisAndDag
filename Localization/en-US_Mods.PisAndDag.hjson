Tips: {
	Next: Next
	VanillaTitle: Common Knowledge

	List: {
		GolemFist: {
			Title: The Golem's Fist
			Text:
				'''
				A Golem's fist can be parried.
				It turns about and flies back crashing into the Golem.
				'''
		}

		ThirdParry: {
			Title: Parry
			Text:
				'''
				Parry an enemy enough and it staggers.
				During stagger, a strike will be three fold critical.
				'''
		}

		SolidThings: {
			Title: Arrows and Bullets
			Text: Projectiles that are solid things can be broken upon parry.
		}

		ShimmerLock: {
			Title: Shimmer Is Sealed Away
			Text:
				'''
				In a chamber at the end of the land.
				Not only is it sealed but its properties are not the same.
				'''
		}

		PugreamCoconut: {
			Title: Pugream's Coconuts
			Text:
				'''
				He picked three up from the sandy beach.
				And he gave you two.
				'''
		}

		YellowStar: {
			Title: The Yellow Star
			Text:
				'''
				A yellow star, and after it a yellow outline.
				This signifies a blow that will move the player.
				'''
		}

		LanceAndDonkey: {
			Title: Lance and Donkey
			Text:
				'''
				Someone awaits you before Wasted Miles.
				They appear in Pre Hardmode, after Eye of Cthulhu.
				'''
		}

		Magazines: {
			Title: Magazines
			Text:
				'''
				A gun reloads by itself when its magazine runs dry.
				The Reload key does it sooner.
				A gun put away goes on reloading.
				'''
		}

		Megashark: {
			Title: The Megashark
			Text:
				'''
				Do not get too far from a Megashark.
				It will enter enraged mode.
				'''
		}

		Handswitch: {
			Title: The Handswitch
			Text: Watch the lifeforce bar when you hold it.
		}

		Grounded: {
			Title: Bounded to the Ground
			Text:
				'''
				Wings are restricted until you beat a lady with wings.
				She shines and hates the sun.
				'''
		}

		Mana: {
			Title: Mana
			Text:
				'''
				Mana does not come back on its own.
				Stand still 2 seconds and it does, at 15 a second.
				Accessories bring it back. A Mana Regeneration Potion does not.
				'''
		}

		ManaPotions: {
			Title: One Potion Too Many
			Text:
				'''
				Every mana potion makes the screen swim for a while.
				More than five inside two minutes are poison:
				10 life a second, 20 with the stronger kinds.
				'''
		}

		Arsenal: {
			Title: The Magic Arsenal
			Text:
				'''
				A spell or an incantation does nothing in the pack.
				It goes in the Magic Arsenal, near a house someone lives in. 
				'''
		}

		Altar: {
			Title: The Makeshift Altar
			Text:
				'''
				Spells and incantations are written, each with a Book.
				The altar for it is 15 Bones, 10 Wood and a Book,
				put together at a Work Bench.
				'''
		}

		Mile: {
			Title: The Wasted Mile
			Text:
				'''
				Bunnies and squirrels placed on the Wasted Mile calls a monster.
				The world keeps count of them.
				The tenth is answered.
				'''
		}

		OnFoot: {
			Title: On Foot
			Text:
				'''
				Nobody arrives in the Kingdom of Grace but on foot.
				No rod, potion, pylon or conch sets you down inside.
				No bed there will keep a spawn point.
				'''
		}

		Builders: {
			Title: What the Builders Laid
			Text:
				'''
				What the kingdom's builders laid cannot be broken.
				What you build inside its walls, you can take up again.
				'''
		}

		Shimmer: {
			Title: Shimmer
			Text:
				'''
				Shimmer changes nothing that goes into it.
				Not yet.
				'''
		}

		LoreItems: {
			Title: Lore Items
			Text:
				'''
				A lore item cannot be dropped, trashed, stored or reforged.
				The Lore Codex holds any that are in the way.
				'''
		}

		Trumpet: {
			Title: A Tune of Your Own
			Text:
				'''
				The trumpet can be taught a tune.
				/trumpet learn NAME, then /trumpet add for each part
				of the score, then /trumpet save.
				'''
		}

		Dash: {
			Title: A Dash Goes Level
			Text:
				'''
				A dash carries you level, even over a drop.
				You fall again the moment it is spent.
				'''
		}

		NameRead: {
			Title: While the Name Is Read
			Text:
				'''
				A boss does not fight while its name is on the screen.
				Nor can it be hurt until the name is gone.
				'''
		}

		Carried: {
			Title: Things Carried
			Text:
				'''
				The item you have in your inventory or Lore Codex will unlock
				dialogues from different NPCs.
				'''
		}
	}
}

