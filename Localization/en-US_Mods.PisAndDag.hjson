Items: {
	EverclearMirror: {
		DisplayName: Everclear Mirror
		Tooltip:
			'''
			Calls a copy of you out of the mirror to fight beside you
			It fights with a copy of your off hand's weapon, or of the best weapon on your hotbar, right click and all
			It wears what you wear and has your buffs
			Three times your life, and 30 Super Healing Potions of its own
			Enemies go after it as they would another player
			Takes 15 minion slots
			If it breaks, the mirror clouds over for a minute
			Single player only
			'It learned you faster than you learned it.'
			'''
		Clouded: Clouded over: {0} seconds more
		NoRoom: Needs room for {0} minions (you have {1})
	}

	BoulderCatapult: {
		DisplayName: Boulder Catapult
		Tooltip:
			'''
			Throws a boulder in an arc that comes down on the cursor
			Where it lands it rolls on as any boulder does, crushing what it rolls over
			'The hill had been saving it for someone.'
			'''
	}

	DeepRoots: {
		DisplayName: Deep Roots
		Tooltip:
			'''
			Calls up three roots through the ground near the cursor, pointed at it
			Where there is no ground they come out of the walls behind
			Each goes through 3 enemies
			'They go where they are sent. They do not stop.'
			'''
	}

	OvergrownRoot: {
		DisplayName: Overgrown Root
		Tooltip: "'Still growing. It does not know it was cut.'"
	}

	GildedSpur: {
		DisplayName: Gilded Spur
		Tooltip:
			'''
			Summons the Gilded Knight of Grace on the willow field before the great wall
			Not consumed
			'It rings for one man, and he always comes.'
			'''
	}

	SwordOfAGildedKnight: {
		DisplayName: Sword Of A Gilded Knight
		Tooltip:
			'''
			Cuts up, then down
			Right click to raise a blade of light and bring it down for five times the damage
			'It has been dropped on that road before.'
			'''
	}

	SunburstTalisman: {
		DisplayName: Sunburst Talisman
		Tooltip:
			'''
			Above ground in the day, regenerates 10 life per second
			7.3% increased damage in the day, 4.5% at night
			'He knelt to it each morning, on the road.'
			'''
	}

	Handswitch: {
		DisplayName: Handswitch
		Tooltip: Trades lifeforce for powerful shots
	}

	BladeOfMors: {
		DisplayName: Blade Of Mors
		Tooltip: ""
	}

	MeleeDecider: {
		DisplayName: Melee Decider
		Tooltip: ""
	}

	PouchOfBerries: {
		DisplayName: Pouch of Berries
		Tooltip: They did not rot. They went soft instead.
	}

	ReliquaryKey: {
		DisplayName: Reliquary Key
		Tooltip: "'Cut for a door that was meant to stay shut.'"
	}

	LocketOfABookCrazedGirl: {
		DisplayName: Locket Of A Book-Crazed Girl
		Tooltip: "'It was opened more often than it was closed.'"
	}

	WeatheredLedger: {
		DisplayName: Weathered Ledger
		Tooltip:
			'''
			Bound in leather gone soft with damp.
			Someone left it here on purpose.
			'''
	}

	PieceOfPaper: {
		DisplayName: Piece of Paper
		Tooltip:
			'''
			Torn in corners and folded in four.
			There is something written on it.
			'''
	}

	GameChangingOrb: {
		DisplayName: Ominous Orb
		Tooltip:
			'''
			Can only be set upon an anvil
			Once placed, it cannot be taken back
			Break it, and the all evil will bat their eyes
			The world permanently enter Afflictio Mode, changing AIs but also new rewards
			'''
	}

	Accessories: {
		GreenCandiez: {
			DisplayName: Green Candiez
			Tooltip:
				'''
				Allows flight, super fast running, and extra mobility on ice
				8% increased movement speed
				Provides the ability to walk on water, honey & lava
				Grants immunity to fire blocks and 7 seconds of immunity to lava
				Reduces damage from touching lava
				Allows the holder to quadruple jump
				Negates fall damage
				6 mph more top speed
				Cannot be worn with Terraspark Boots or the bottle it is made from
				'The sparks are the polite part.'
				'''
		}

		QueenSlimesWings: {
			DisplayName: Queen Slime's Wings
			Tooltip:
				'''
				Allows flight and slow fall
				Hold Up to boost faster!
				'They wobble. They should not hold you up. They do.'
				'''
		}

		RageOfAThunder: {
			DisplayName: Rage Of A Thunder
			Tooltip: ""
		}

		TripleFartInAHorseShoeAdornedBottle: {
			DisplayName: Triple Fart In A Horse Shoe Adorned Bottle
			Tooltip:
				'''
				Allows the holder to quadruple jump
				Negates fall damage
				'The horseshoe is for luck. So is the cork.'
				'''
		}

		Boots: {
			DisplayName: Boots
			Tooltip: "'Plain enough. Someone handy could make more of them.'"
		}

		MetallurgistsBrilliantStone: {
			DisplayName: Metallurgist's Brilliant Stone
			Tooltip:
				'''
				Shows the ore near you as if in full light
				'The metal answers it, even in the dark.'
				'''
		}

		DryadsBlessing: {
			DisplayName: Dryad's Blessing
			Tooltip:
				'''
				A hit that would kill you leaves you at 25 life
				Then 1.5 seconds of invincibility, and 20 life a second for 5 seconds
				Ready again after 10 minutes, or when you respawn
				'She does not let go of what she is handed.'
				'''
		}

		NecklaceOfTheAcademy: {
			DisplayName: Necklace Of The Academy
			Tooltip:
				'''
				One more Magic Arsenal slot
				5% increased magic damage
				'A first year's necklace. The clasp reads H. L.'
				'''
		}

		BoneCasing: {
			DisplayName: Bone Casing
			Tooltip:
				'''
				A cage of ribs takes every attack in your place
				The ribs have 100 life, and the hit that breaks them is taken whole
				They stand again after 1.5 minutes, or when you respawn
				'It held a heart once. It is not fussy about whose.'
				'''
		}

		Mupral: {
			DisplayName: M.U.P.R.A.L
			Tooltip:
				'''
				Mechanic's Ultra Pressure Resistance Anchored Lantern, worn on the shoulder
				Glow: a dim light around you, 6.1 tiles in air, 3.7 in water
				Beam: a 30 degree beam, 50 tiles in water, 68 in air
				While it beams, the glow around you is only 1.2 tiles
				Blocks in its way cast shadows
				Lights the deep of the Vast Ocean, where no other light reaches
				'Rated for depths nobody has come back from to rate.'
				'''
			NowGlow: Now the glow. While worn, right click it or press {0} for the beam
			NowBeam: Now the beam. While worn, right click it or press {0} for the glow
			NoKey: its key (unset, in Controls)
		}

		HEATR: {
			DisplayName: H.E.A.T.R
			Tooltip:
				'''
				Hyper Engineered Abyssal Trench Roamer
				Lets you breathe underwater
				Immune to the water's weight, down to the floor of the Vast Ocean
				Its lamp glows 20 tiles around you in water, 33 in air
				and beams 45 degrees wide, 50 tiles in water, 68 in air, both at once
				15% lower top speed and jump speed
				'The lamp was the easy part.'
				'''
			TopSpeedWorn: Your top speed: {0} mph, {1} mph without it
			TopSpeedOff: Your top speed with it: {0} mph, {1} mph now
		}
	}

	Chlorophyte_Rifle: {
		DisplayName: Chlorophyte Rifle
		Tooltip: ""
	}

	DentedMegashark: {
		DisplayName: Dented Megashark
		Tooltip: ""
	}

	Instrument: {
		Trumpet: {
			DisplayName: Trumpet
			Tooltip:
				'''
				Twelve bands down the screen, low at the bottom: where the cursor is, is the note
				Left click plays it, right click plays it an octave up
				Hold to sustain, drag to slide, fifteen seconds at most. Alt plays soft
				'It has never once been played quietly.'
				'''
		}
	}

	Trumpet: {
		DisplayName: Trumpet
		Tooltip: ""
	}

	GreatbowOfAPilgrim: {
		DisplayName: She Who Sings
		Tooltip: Wait 5 seconds to shoot a piercing arrow
	}

	WoodenCrossbow: {
		DisplayName: Wooden Crossbow
		Tooltip: "'Wood, string, and one stubborn iron trigger.'"
	}

	Mycellaneous: {
		DisplayName: Mycellaneous
		Tooltip:
			'''
			Arrows that hit an enemy send you back 2 or 3 life, 5 on a critical hit
			'Mushrooms grow on what is done with. So do you.'
			'''
	}

	MeagreFlame: {
		DisplayName: Meagre Flame
		Tooltip:
			'''
			Throws a ball of fire that bursts on what it meets
			Hold 2 seconds to gather it: twice the size, three times the damage, 40 mana
			'Enough to set a thing alight. And that's alright.'
			'''
	}

	SealOfAClothier: {
		DisplayName: Clothier's Chatelaine
		Tooltip: "[c/9e6fab:A Seal]"
	}

	CourtOfHands: {
		DisplayName: Court Of Hands
		Tooltip:
			'''
			Calls hands up out Of The ground under the cursor, three at a time, for 5 seconds
			Click elsewhere to move them. Hold 2 seconds and they follow the cursor, at 14 mana a second
			'Can I get a show of hands?'
			'''
	}

	EverHunger: {
		DisplayName: Everhunger
		Tooltip:
			'''
			Lets a mouth out of your chest that runs level, toward the cursor's side
			Comes back for the first thing it bites, dies after 5 bites
			Anything else in its way takes two thirds the damage
			'Even in soul they keep biting.'
			'''
	}

	EssenceOfTheFouled: {
		DisplayName: Essence Of The Fouled
		Tooltip: "'It ate itself down to this.'"
	}

	AmalgaermisBag: {
		DisplayName: Treasure Bag ({$Mods.PisAndDag.NPCs.AbomanationHead.DisplayName})
		Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
	}

	JointArmsOfTheDefiled: {
		DisplayName: Joint Arms Of The Defiled
		Tooltip:
			'''
			{$CommonItemTooltip.Whips}
			5 cracks in a row that land charge the next one
			A charged crack gives 50% more summon damage for 11 seconds
			'The end of it is the worst of it.'
			'''
		Streak: Streak: {0}/{1}
		Charged: Charged
	}

	MakeshiftAltar: {
		DisplayName: Makeshift Altar
		Tooltip: Used to write incantations and spells
	}

	TreeBranchStaff: {
		DisplayName: Branch Staff
		Tooltip:
			'''
			[c/9e6fab:A Staff]
			'Do you think the Dryad cut a tree branch for this?'
			'''
	}

	ColdCall: {
		DisplayName: Cold Call
		Tooltip:
			'''
			Calls five icicles out Of The staff in a wave, one full wave a cast
			Each homes on the nearest enemy 
			Inflicts Frostbite, and Chilled
			'Somebody always picks up.'
			'''
	}

	DancingSand: {
		DisplayName: Dancing Sand
		Tooltip:
			'''
			Blows a spray of sand off the staff, up to 30 tiles
			Hits again and again, faster the closer the enemy
			'The desert has plenty. It will not miss a mouthful.'
			'''
	}

	ForestNurtureMe: {
		DisplayName: Forest, Nurture Me
		Tooltip:
			'''
			Asks the forest to keep you a while
			Faster life and mana regeneration, more defense, more speed
			Can only be asked again as it fades
			'Rustle the leaves.'
			'''
	}

	AquaticFirearms: {
		DisplayName: Aquatic Firearms
		Tooltip:
			'''
			Calls a Minishark, a Megashark and an S.D.M.G. above you
			Held, they fire musket balls where you point, needing no ammo
			After a few seconds, holding it drains mana
			'All three sea monsters answer to one finger.'
			'''
	}

	ChlorophyteArmMe: {
		DisplayName: Chlorophyte, Arm Me
		Tooltip:
			'''
			Asks the jungle to arm you a while
			Bullets you fire of lower rarity than chlorophyte become chlorophyte
			They home, but hit as hard as they would have
			Can only be asked again as it fades
			'To me my jungle.'
			'''
	}

	Visus: {
		DisplayName: Visus
		Tooltip:
			'''
			Each thrust carries you a step forward
			Right click brings it down from overhead for triple damage
			'Is the eye blinking?'
			'''
	}

	FleshMaiden: {
		DisplayName: Flesh Maiden
		Tooltip:
			'''
			Swings down, then up, then thrusts
			Right click smashes it down for 2.5 times the damage
			The smash throws you back
			'The eye has company now.'
			'''
	}

	FlySwatter: {
		DisplayName: Fly Swatter
		Tooltip:
			'''
			Kills bees and hornets in one hit
			Hits everything its swing touches
			Deals 70 base damage to the Queen Bee
			'You like jazz?'
			'''
	}

	IronFlow: {
		DisplayName: Tusked Man's Curved Sword
		Tooltip: Right click to parry
	}

	RageSweetFire: {
		DisplayName: Rage! Sweet Fire
		Tooltip:
			'''
			Asks the fire to rage with you a while
			Your fire deals 25% more damage
			Flamethrowers, solar weapons and anything that sets foes alight
			Can only be asked again as it fades
			'Whoever named it had not yet been burned.'
			'''
	}

	WaterResuscitateMe: {
		DisplayName: Water! Resuscitate Me!
		Tooltip:
			'''
			Asks the water to let you breathe it a while
			Breathe water instead of air for {0} minutes
			Safe from the water's weight down to {1} feet
			Can only be asked again as it fades
			'Best said while your mouth is still above water.'
			'''
	}

	BetsysFlames: {
		DisplayName: Betsy's Flames
		Tooltip:
			'''
			Turns your head into Betsy's to breathe her fire at the cursor for 5 seconds
			The flames set foes on fire
			'It borrows her face. Your jaw aches for days.'
			'''
	}

	SubworldDoor: {
		DisplayName: Unmarked Door
		Tooltip:
			'''
			Right click to step through
			Once placed, it cannot be taken back
			'It was not there yesterday.'
			'''
	}

	MeatHook: {
		DisplayName: Meat Hook
		Tooltip:
			'''
			Fires a spread of 8 bullets
			Right click throws the hook, 50 tiles at most
			It drags a small enemy to you, and you to anything else
			Shots fired while it holds an enemy deal double damage
			Ready 3 seconds after it comes back, 5 if it caught nothing
			'It was made to hold what had stopped moving.'
			'''
	}

	FoighsRustSideSword: {
		DisplayName: Foigh's Rust Side Sword
		Tooltip:
			'''
			Ignores all defense
			Right click shoots up to three slashes.
			Hold Enter for 3 seconds, standing, to drench it in blood
			'The rusted side was used on one man, for centuries.'
			'''
	}

	HoardOfUndead: {
		DisplayName: Hoard of Undead
		Tooltip: Summons a zombie to fight for you
	}

	BoneSquad: {
		DisplayName: Bone Squad
		Tooltip:
			'''
			Summons a squad of six skeletons to fight for you
			Takes 5.5 minion slots
			'''
	}

	Worminator: {
		DisplayName: Worminator
		Tooltip:
			'''
			Summons a worm that tunnels through the ground to fight for you
			Each summon after the first lengthens the worm by one segment
			'It is always under you.'
			'''
	}

	VultureStaff: {
		DisplayName: Vulture Staff
		Tooltip:
			'''
			Summons a vulture to fight for you
			Vultures circle the weakest enemy near you and dive at it
			They deal 25% more damage to enemies under half health
			A kill makes them dive more often for 3 seconds
			'They are very good at waiting.'
			'''
	}

	Mantrap: {
		DisplayName: Mantrap
		Tooltip:
			'''
			Throws iron jaws that shut on the first enemy they hit, holding a small one still for 1 second
			Jaws that miss lie open where they land, and shut on the next enemy to step in for 50% more damage
			Up to 3 lie open at once. They shut on your foot too
			'A better trap. That was the whole war.'
			'''
	}

	MyceliumFinishThem: {
		DisplayName: Mycelium, Finish Them
		Tooltip:
			'''
			Calls a ring of glowing caps up out of the ground under the cursor, for 10 seconds
			Spores hurt everything inside the ring every half second
			Whatever dies in the ring sinks into the ground
			A cap comes up where it lay and puffs spores at enemies
			'Here, at least, the dead go somewhere.'
			'''
	}

	Defacer: {
		DisplayName: Defacer
		Tooltip:
			'''
			Hold to lift it, release to bring it down. You walk slower while it is lifted
			The higher it was lifted, the harder it hits, up to 220% damage
			Lifted all the way, it throws stone chips and leaves what it hits Defaced for 8 seconds
			'Faces first. Then the names.'
			'''
	}

	ParadeSabre: {
		DisplayName: Parade Sabre
		Tooltip:
			'''
			Every hit on an enemy flakes off a little of its gold leaf
			When the gold is gone it is plain steel, and hits harder for good
			'The gold was for the parade.'
			'''
		GiltLeft: "{0} hits of gold leaf left"
	}

	ParadeSabreBare: {
		DisplayName: Plain Sabre
		Tooltip: "'Under the gold, a sword.'"
	}

	SignalPistol: {
		DisplayName: Signal Pistol
		Tooltip:
			'''
			Fires a flare that burns for 6 seconds, stuck in what it hits or where it lands
			It lights the dark red, sinks slowly in water, and draws what swims toward it
			While a flare burns, your own sight is dimmed
			'Red means come. Nobody came.'
			'''
	}

	HarenaeumOre: {
		DisplayName: Harenaeum Ore
		Tooltip: 
	}

	HarenaeumBar: {
		DisplayName: Harenaeum Bar
		Tooltip: "Grimey"
	}

	PocketSandstorm: {
		DisplayName: Pocket Sandstorm
		Tooltip: Yoyo that spins needles of sand around it.
	}

	Corosion: {
		DisplayName: Corosion
		Tooltip:  
			Right-click to scatter into sand and step back 10 tiles, untouchable (7 second cooldown) 
	}

	ScorpiusServus: {
		DisplayName: Scorpius Servus
		Tooltip:
			'''
			Grows a scorpion's tail from your back to fight for you
			'''
	}

	JellesSableHelper: {
		DisplayName: Jelle's Sable Helper
		Tooltip:
			'''
			A trail of sand flies around your body
			When encountering a hoard or a boss, it forms a ballista to fight for you.
			'''
	}

	Sidewinder: {
		DisplayName: Sidewinder
		Tooltip:
			'''
			Arrow shot onto the ground will dig its way up to the nearest enemy, dealing extra damage.
			'''
	}

	TheLastGrain: {
		DisplayName: The Last Grain
		Tooltip:
			''' 
			'''
	}

	ClayTurbah: {
		DisplayName: Clay Turbah
		Tooltip:
			'''
			[c/9e6fab:A Seal]
			Earth incantations deal 15% more damage
			'It is used to rest the heads during prayers.'
			'''
	}

	MiniSandstorm: {
		DisplayName: Mini Sandstorm
		Tooltip:
			'''
			Calls a small tornado of sand
			Tornado shoots small enemies upwards.
			'''
	}
}

