		Tooltip: "'Cut for a door that was meant to stay shut.'"
	}

	LocketOfABookCrazedGirl: {
		DisplayName: Locket of a Book-Crazed Girl
		Tooltip: "'It was opened more often than it was closed.'"
	}

	PieceOfPaper: {
		DisplayName: Piece of Paper
		Tooltip: ""
	}

	GameChangingOrb: {
		DisplayName: Ominous Orb
		Tooltip:
			'''
			Can only be set upon an anvil
			Once placed, it cannot be taken back
			Break it, and the world is asked a question it cannot refuse
			'''
	}

	Accessories: {
		RageOfAThunder: {
			DisplayName: Rage Of A Thunder
			Tooltip: ""
		}
	}

	Chlorophyte_Rifle: {
		DisplayName: Chlorophyte Rifle
		Tooltip: ""
	}

	DentedMegashark: {
		DisplayName: Dented Megashark
		Tooltip: ""
	}

	Instrument: {
		Trumpet: {
			DisplayName: Trumpet
			Tooltip:
				'''
				Twelve bands down the screen, low at the bottom: where the cursor is, is the note
				Left click plays it, right click plays it an octave up
				Hold to sustain, drag to slide, fifteen seconds at most. Alt plays soft
				'It has never once been played quietly.'
				'''
		}
	}

	Trumpet: {
		DisplayName: Trumpet
		Tooltip: ""
	}

	GreatbowOfAPilgrim: {
		DisplayName: She Who Sings
		Tooltip: Wait 5 seconds to shoot a piercing arrow
	}

	MeagreFlame: {
		DisplayName: Meagre Flame
		Tooltip:
			'''
			Throws a ball of fire that bursts on what it meets
			Hold 2 seconds to gather it: twice the size, three times the damage, 40 mana
			'Enough to set a thing alight. Not much more.'
			'''
	}

	SealOfAClothier: {
		DisplayName: Clothier's Chatelaine
		Tooltip: "[c/9e6fab:A Seal]"
	}

	CourtOfHands: {
		DisplayName: Court of Hands
		Tooltip:
			'''
			Calls hands up out of the ground under the cursor, three at a time, for 5 seconds
			Click elsewhere to move them. Hold 2 seconds and they follow the cursor, at 14 mana a second
			'Can I get a show of hands?'
			'''
	}

	EverHunger: {
		DisplayName: Everhunger
		Tooltip:
			'''
			Lets a mouth out of your chest that runs level, toward the cursor's side
			Comes back for the first thing it bites, dies after 5 bites
			Anything else in its way takes two thirds the damage
			'It is never full. It only runs out.'
			'''
	}

	EssenceOfTheFouled: {
		DisplayName: Essence of the Fouled
		Tooltip: "'It ate itself down to this.'"
	}

	AmalgaermisBag: {
		DisplayName: Treasure Bag ({$Mods.PisAndDag.NPCs.AbomanationHead.DisplayName})
		Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
	}

	JointArmsOfTheDefiled: {
		DisplayName: Joint Arms of the Defiled
		Tooltip:
			'''
			{$CommonItemTooltip.Whips}
			5 cracks in a row that land charge the next one
			A charged crack gives 50% more summon damage for 11 seconds
			'The end of it is the worst of it.'
			'''
		Streak: Streak: {0}/{1}
		Charged: Charged
	}

	MakeshiftAltar: {
		DisplayName: Makeshift Altar
		Tooltip:
			'''
			Used to write incantations and spells
			'Nobody blessed it. It works anyway.'
			'''
	}

	TreeBranchStaff: {
		DisplayName: Branch Staff
		Tooltip:
			'''
			[c/9e6fab:A Staff]
			'Do you think the Dryad cut a tree branch for this?'
			'''
	}

	ColdCall: {
		DisplayName: Cold Call
		Tooltip:
			'''
			Calls five icicles out of the staff in a wave, one full wave a cast
			Each homes on the nearest enemy 
			Inflicts Frostbite, and Chilled
			'Somebody always picks up.'
			'''
	}

	ForestNurtureMe: {
		DisplayName: Forest, Nurture Me
		Tooltip:
			'''
			Asks the forest to keep you a while
			Faster life and mana regeneration, more defense, more speed
			Can only be asked again as it fades
			'The forest cannot say no. That is the trouble.'
			'''
	}

	AquaticFirearms: {
		DisplayName: Aquatic Firearms
		Tooltip:
			'''
			Calls a Minishark, a Megashark and an S.D.M.G. above you
			Held, they fire musket balls where you point, needing no ammo
			After a few seconds, holding it drains mana
			'All three answer to one finger.'
			'''
	}

	ChlorophyteArmMe: {
		DisplayName: Chlorophyte, Arm Me
		Tooltip:
			'''
			Asks the jungle to arm you a while
			Bullets you fire of lower rarity than chlorophyte become chlorophyte
			They home, but hit as hard as they would have
			Can only be asked again as it fades
			'It was grown to stop one thing. It stops anything.'
			'''
	}

	Visus: {
		DisplayName: Visus
		Tooltip:
			'''
			Each thrust carries you a step forward
			Right click brings it down from overhead for triple damage
			'It watched you long before you held it.'
			'''
	}

	FleshMaiden: {
		DisplayName: Flesh Maiden
		Tooltip:
			'''
			Swings down, then up, then thrusts
			Right click smashes it down for 2.5 times the damage
			The smash throws you back
			'The eye has company now.'
			'''
	}

	FlySwatter: {
		DisplayName: Fly Swatter
		Tooltip:
			'''
			Kills bees and hornets in one hit
			Hits everything its swing touches
			Deals 70 base damage to the Queen Bee
			'Meant for flies. Nobody told the bees.'
			'''
	}

	RageSweetFire: {
		DisplayName: Rage! Sweet Fire
		Tooltip:
			'''
			Asks the fire to rage with you a while
			Your fire deals 25% more damage
			Flamethrowers, solar weapons and anything that sets foes alight
			Can only be asked again as it fades
			'Whoever named it had not yet been burned.'
			'''
	}
}

