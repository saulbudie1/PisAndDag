DeathText: {
	ManaPoisoning: "{0} drank one potion too many."
	KeptBehindTheWall: "{0} was kept behind the Wall."
	UnderTheSkull: "{0} was under the skull when it came down."
	DonaLance: "{0} was run through by a knight who was never knighted."
	DonaLanceThrown: "{0} met a lance on its way into the ground."
	DonaTrampled: "{0} was run down by a donkey with somewhere to be."
	DonaSwept: "{0} was swept off their feet by a lance."
	AmalgaermisSteam: "{0} was standing over it when the hundred breathed out."
	FoighSword: "{0} could not give an old man what he asked for."
	FoighDagger: "{0} did not see the knife leave his hand."
	FoighSwordThrown: "{0} was where the sword came down."
	FoighSpitted: "{0} drank, and was lifted off the ground."
	FoighHeld: "{0} was held close while the sword took its time."
	FoighLate: "{0} was cut a moment after the sword had gone by."
	FoighSmite: "{0} was sent back down."
	FoighReturned: "{0} was given back what they sent."
	FoighBled: "{0} bled with the sword."
	FoighSlash: "{0} was cut by a sword that was nowhere near."
	FoighHook: "{0} came when the chain was pulled."
	FoighLine: "{0} saw where the cut would be, and stood there."
	Pressed1: "{0} went deeper than they were made to."
	Pressed2: "{0} was pressed flat by the sea."
	Pressed3: "{0} felt the whole sea lean on them."
	Crushed1: "{0} went a fathom too deep."
	Crushed2: "{0} caved in like an empty tin."
	Crushed3: "{0} was made very small by the sea."
	Mantrap: "{0} stepped where they had set it."
	VisualIntoxication: "{0} saw what lies outside."
	GildedKnightBlade: "{0} came up the road, and got no further."
	GildedKnightShock: "{0} was thrown down by the ground he struck."
	GildedKnightCrescent: "{0} was cut by a sword swung a long way off."
	GildedKnightLancet: "{0} was run through from the far end of the field."
	GildedKnightVotive: "{0} was found by a blade nobody held."
	GildedKnightPyre: "{0} stood where the ground was about to burn."
	GildedKnightGreat: "{0} was inside the arc when it burst."
	GildedKnightProcession: "{0} was in the way of the fire coming down the road."
	GildedKnightLong: "{0} was under a blade as tall as the sky."
	GildedKnightSun: "{0} saw the sun come down."
	GildedKnightLight: "{0} was caught in the gold."
}

